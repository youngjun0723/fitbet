# cp .env.example .env 후 값을 바꾼다. (.env는 git에 올라가지 않는다)

# 외부 공개 방식: tunnel(집 PC + Cloudflare Tunnel) 또는 caddy(VPS)
COMPOSE_PROFILES=tunnel

# [tunnel] Cloudflare Zero Trust > Networks > Tunnels 에서 터널 생성 시 받은 토큰
TUNNEL_TOKEN=paste-your-tunnel-token-here

# [caddy] VPS에서만 사용: 접속 도메인 (이 이름으로 HTTPS 인증서 발급)
SITE_ADDRESS=fitbet.example.com

# DB 계정 — 반드시 긴 랜덤 문자열로 바꿀 것
#   Git Bash: openssl rand -base64 24
DB_USERNAME=fitbet
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
